# AL156A (NVIDIA G-Sync module) Nios II SoC
# Quartus Prime Standard 18.1
# DDR3 pinout identical to ddr3_test; peripherals identical to AL156A/all_test

set_global_assignment -name FAMILY "Arria V"
set_global_assignment -name DEVICE 5AGXMA3D4F31I3
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name VERILOG_FILE top.v
set_global_assignment -name VERILOG_FILE rtl/AlvxChip.v
set_global_assignment -name VERILOG_FILE rtl/soc.v
set_global_assignment -name VERILOG_FILE rtl/avl_demux.v
set_global_assignment -name VERILOG_FILE rtl/avl_mux.v
set_global_assignment -name VERILOG_FILE rtl/avl_cdc.v
set_global_assignment -name VERILOG_FILE rtl/avl2axil.v
set_global_assignment -name VERILOG_FILE rtl/avl2apb.v
set_global_assignment -name VERILOG_FILE rtl/boot_ram.v
set_global_assignment -name VERILOG_FILE rtl/ddr_avl_bridge.v
set_global_assignment -name VERILOG_FILE rtl/fb_reader.v
set_global_assignment -name VERILOG_FILE src/hdmi/fb_video.v
set_global_assignment -name VERILOG_FILE src/hdmi/dvi_encoder.v
set_global_assignment -name VERILOG_FILE src/hdmi/dvi_transmitter_top.v
set_global_assignment -name VERILOG_FILE src/hdmi/serializer_10_to_1.v
set_global_assignment -name QIP_FILE src/ddio/ddio_out.qip
set_global_assignment -name QIP_FILE ip/synth/synthesis/emifsys.qip
set_global_assignment -name QIP_FILE ip/synth/synthesis/vidpll.qip
set_global_assignment -name SDC_FILE vex_soc.sdc
# generated Spinal code guards sim-only code ($urandom, $display, string regs)
# behind `ifndef SYNTHESIS
set_global_assignment -name VERILOG_MACRO SYNTHESIS
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"

# ---- board clock ----
set_location_assignment PIN_T4 -to i_sys_clk
set_instance_assignment -name IO_STANDARD "SSTL-135" -to i_sys_clk

# ---- peripherals (same as AL156A/all_test) ----
