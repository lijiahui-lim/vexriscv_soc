# ALVX SoC kernel fragment (merge over arch/riscv rv32_defconfig)
CONFIG_SMP=n
CONFIG_MODULES=y
CONFIG_DEBUG_INFO=n

# console path
CONFIG_SERIAL_ALVX=y
CONFIG_SERIAL_ALVX_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# SD card over our SPI master
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_ALVX=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SPI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# framebuffer console on the generated video pipeline
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_HW_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y

# base
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_TIOCSTI=n
CONFIG_PANIC_TIMEOUT=0
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
# CONFIG_EFI is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
